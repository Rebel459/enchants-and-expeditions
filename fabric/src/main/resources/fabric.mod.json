{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}-fabric",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/Rebel459/enchants-and-expeditions"
  },
  "license": "${license}",
  "icon": "assets/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.rebel459.enchants_and_expeditions.EnchantsAndExpeditionsFabric"
    ],
    "client": [
      "net.rebel459.enchants_and_expeditions.EnchantsAndExpeditionsFabricClient"
    ],
    "fabric-datagen": [
      "net.rebel459.enchants_and_expeditions.datagen.EaEDataGenerator"
    ],
    "modmenu": [
      "net.rebel459.enchants_and_expeditions.config.EaEModMenuIntegration"
    ]
  },
  "mixins": [
    "enchants_and_expeditions.mixins.json",
    "enchants_and_expeditions-fabric.mixins.json"
  ],
  "accessWidener": "enchants_and_expeditions.classtweaker",
  "depends": {
    "fabricloader": ">=0.18",
    "fabric-api": "*",
    "minecraft": "${fabric_minecraft_version}",
    "java": ">=25",
    "unified": "*",
    "cloth-config": "*",
    "item_tooltips": "*"
  }
}